# Vorlage für die Umgebungsvariablen. Für lokale Entwicklung nach .env kopieren
# und Werte anpassen. Im Docker-Setup werden diese über docker-compose.yml /
# eine eigene .env-Datei neben der docker-compose.yml gesetzt (siehe README).

# SQLite-Datenbankdatei. Lokal reicht der relative Pfad; im Docker-Container
# zeigt DATABASE_URL auf das persistente Volume (siehe docker-compose.yml).
DATABASE_URL="file:./dev.db"

# Geheimer Schlüssel für NextAuth-Sessions. Für die Produktivumgebung einen
# eigenen, zufälligen Wert erzeugen, z. B. mit: openssl rand -base64 32
AUTH_SECRET="changeme-generate-a-real-secret"

# Öffentlich erreichbare URL der Anwendung (z. B. für Links in E-Mails/ICS-Feed).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# E-Mail-Versand für Benachrichtigungen (optional). Bleiben SMTP_HOST bzw.
# SMTP_FROM leer, läuft die App normal weiter und verschickt einfach keine
# E-Mails. SMTP_SECURE wird sonst aus dem Port abgeleitet (465 = TLS).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE=""

# Song-Metadaten-Recherche beim Anlegen eines Songs (optional). Ohne
# MUSICBRAINZ_USER_AGENT bleibt die Online-Recherche ausgeschaltet, die App läuft
# normal weiter (ID3-Erkennung aus hochgeladenen Dateien ist davon unabhängig).
MUSICBRAINZ_USER_AGENT=""
DISCOGS_TOKEN=""
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Adresssuche für Orte (optional). Standardmäßig wird die öffentliche
# Nominatim-Instanz von OpenStreetMap genutzt - für eine eigene Instanz hier
# die Basis-URL eintragen.
NOMINATIM_BASE_URL=""
