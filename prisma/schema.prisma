// Bandplaner - Datenmodell für die Kernmodule
// Auth, Bands/Rollen, Kalender, Verfügbarkeiten, Songs, Setlisten

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  MEMBER
  GUEST
}

enum AvailabilityStatus {
  YES
  NO
  MAYBE
}

enum EventType {
  REHEARSAL
  GIG
  MEETING
  OTHER
}

enum GigStatus {
  INQUIRY
  CONFIRMED
  CANCELLED
  DONE
}

enum SongStatus {
  PROPOSED
  NEW
  IN_PROGRESS
  STAGE_READY
  ACTIVE
  ARCHIVED
}

enum FileVisibility {
  PRIVATE
  BAND
}

enum VoteValue {
  UP
  DOWN
}

enum BandFileCategory {
  NOTES
  CONTRACTS
  PHOTOS
  RECORDINGS
  VIDEOS
  OTHER
}

enum BandFileVisibility {
  INTERNAL
  PUBLIC
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  passwordHash       String
  /// Gesetzt, wenn ein Admin ein initiales Passwort vergeben hat (siehe
  /// resetMemberPasswordAction) - erzwingt eine Passwortaenderung ueber
  /// requireActiveUser(), bevor die Person die App sonst nutzen kann.
  mustChangePassword Boolean  @default(false)
  avatarUrl          String?
  createdAt          DateTime @default(now())

  /// Bevorzugte Sprache des Kontos ("de" oder "en"). Vor dem ersten Login
  /// bzw. fuer Gaeste ohne Konto wird stattdessen die Browser-Spracheinstellung
  /// herangezogen - siehe src/i18n/request.ts.
  locale String @default("de")

  /// Zaehler fehlgeschlagener Login-Versuche in Folge - wird bei jedem
  /// erfolgreichen Login zurueckgesetzt. Siehe lockedUntil.
  failedLoginAttempts Int       @default(0)
  /// Gesetzt, sobald failedLoginAttempts den Schwellenwert erreicht hat;
  /// bis zu diesem Zeitpunkt wird jeder Loginversuch abgelehnt, unabhaengig
  /// vom Passwort. Kein Hintergrundjob noetig - die Sperre laeuft einfach
  /// ab, sobald dieser Zeitpunkt in der Vergangenheit liegt.
  lockedUntil         DateTime?

  memberships             Membership[]
  availabilities          Availability[]
  absences                Absence[]
  songNotes               SongNote[]
  createdEvents           Event[]                 @relation("EventCreatedBy")
  eventParticipations     EventParticipant[]
  invitationsSent         Invitation[]            @relation("InvitationInvitedBy")
  setlistNotes            SetlistNote[]
  setlistItemAnnotations  SetlistItemAnnotation[]
  uploadedSongFiles       SongFile[]
  songVotes               SongVote[]
  proposedSongs           Song[]                  @relation("SongProposedBy")
  uploadedBandFiles       BandFile[]
  ownedEquipment          Equipment[]             @relation("EquipmentOwnerUser")
  responsibleForEquipment Equipment[]             @relation("EquipmentResponsible")
  assignedPacklistItems   PacklistItem[]
  financeAdminOf          BandFinanceAdmin[]
  createdFinanceEntries   FinanceEntry[]
  financeAllocations      FinanceAllocation[]

  assignedPacklistItemEventStatuses PacklistItemEventStatus[]
  setlistItemEventAnnotations       SetlistItemEventAnnotation[]
  setlistEventNotes                 SetlistEventNote[]
  assignedLineupEntries             EventLineupEntry[]
  defaultLineupRoles                BandLineupRole[]
  rehearsalSongsAdded               RehearsalSong[]             @relation("RehearsalSongAddedBy")
  practiceLoopsCreated              PracticeLoop[]             @relation("PracticeLoopCreatedBy")

  passwordResetTokens PasswordResetToken[]
}

/// Self-Service-Passwort-Reset per E-Mail-Link (siehe src/lib/password-reset.ts).
/// Ergaenzt, ersetzt aber nicht den weiterhin bestehenden Admin-Reset
/// (resetMemberPasswordAction), der ohne konfigurierten Mailserver funktioniert.
model PasswordResetToken {
  id String @id @default(cuid())

  /// SHA-256-Hash des im Mail-Link enthaltenen Tokens - nie der Klartext, damit
  /// ein DB-Zugriff allein keine Kontouebernahme ermoeglicht.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Band {
  id           String   @id @default(cuid())
  name         String
  imageUrl     String?
  genre        String?
  bio          String?
  location     String?
  contactEmail String?
  websiteUrl   String?
  instagramUrl String?
  facebookUrl  String?
  spotifyUrl   String?
  createdAt    DateTime @default(now())

  /// Funktions-Schalter fuer optionale Module (siehe src/lib/features.ts fuer
  /// Abhaengigkeiten - packlistsEnabled wirkt nur, wenn equipmentEnabled auch an ist).
  equipmentEnabled      Boolean               @default(true)
  packlistsEnabled      Boolean               @default(true)
  /// Finanzmodul ist ein komplett neues Feature (anders als Equipment/Packlisten,
  /// die es schon vorher gab) - Standard bewusst aus, jede Band aktiviert es
  /// aktiv. Siehe BandFinanceAdmin fuer die separate, rollenunabhaengige Liste
  /// der finanzberechtigten Personen.
  financeEnabled        Boolean               @default(false)
  /// Kommunikationsmodul: E-Mail-Benachrichtigungen zu Bandereignissen und
  /// WhatsApp-Teilen-Buttons. Wie das Finanzmodul ein neues Feature, daher
  /// Standard aus. Die persoenlichen Benachrichtigungs-Einstellungen je
  /// Mitglied (siehe Membership) bleiben beim Abschalten erhalten.
  communicationEnabled  Boolean               @default(false)
  /// Medienplayer: Abspielen hinterlegter Audiodateien inkl. Uebungsmodus
  /// (Tempo, Transponieren, Abschnitts-Loop) sowie Einbettung verlinkter
  /// Streaming-Quellen. Steuert ausschliesslich die Player-Oberflaeche -
  /// Up- und Download der Dateien gehoeren zur Songbibliothek und bleiben
  /// davon unberuehrt.
  mediaPlayerEnabled    Boolean               @default(false)
  /// Automatische Tonart-Erkennung im Uebungsmodus (Krumhansl-Schmuckler-Verfahren
  /// auf Basis des Chromagramms, siehe src/lib/key-detection.ts) - Unterfunktion
  /// des Medienplayers, greift daher nur, wenn dieser ebenfalls aktiv ist. Standard
  /// an: rein informativ (nur eine Naeherung), aendert nie automatisch Songdaten -
  /// dafuer muss die Person das Ergebnis aktiv uebernehmen.
  keyDetectionEnabled   Boolean               @default(true)
  /// Abrechnungsmodus fuer das Finanzmodul: NO_BALANCE = kein Bandkonto, Zu-/Abfluesse
  /// muessen immer zu 100% auf Mitglieder verteilt werden (durchgesetzt in
  /// finance/actions.ts). BAND_BALANCE = die Band darf ein eigenes Kapital halten,
  /// nicht verteilte Restbetraege werden automatisch mit dem Bandsaldo verrechnet
  /// (siehe computeBandBalance in finance/page.tsx).
  financeSettlementMode FinanceSettlementMode @default(NO_BALANCE)

  /// Vorbelegung fuer "Zugriff bis" bei neuen Gast-Einladungen (Tage ab Einladung).
  /// null = kein Standard, Admin traegt das Datum wie bisher manuell ein.
  defaultGuestAccessDays Int?

  /// Erlaubt Bandmitgliedern, Dateien ueber einen oeffentlichen, loginfreien Link
  /// zu teilen. Bei false wird auch der Abruf bereits bestehender Links gesperrt
  /// (siehe /api/band-files/public/[shareToken]) - die visibility der Dateien
  /// selbst bleibt dabei unangetastet, damit ein Wiedereinschalten sie sofort
  /// wieder freigibt.
  publicFileLinksEnabled Boolean @default(true)

  /// Orte-Katalog (Venues) mit Adresse/Karte, Kontakt- und Technik-Infos,
  /// verknuepfbar mit Terminen - "Advanced Feature", daher Standard aus.
  locationsEnabled Boolean @default(false)

  /// Proben-Tracking: je Probentermin festhalten, welche Songs geuebt wurden
  /// (explizit zugeordnet und/oder aus verknuepften Setlisten abgeleitet),
  /// mit Historie auf der Song-Detailseite. Neues Feature, Standard aus.
  rehearsalTrackingEnabled Boolean @default(false)

  memberships    Membership[]
  events         Event[]
  songs          Song[]
  setlists       Setlist[]
  absences       Absence[]
  invitations    Invitation[]
  files          BandFile[]
  ownedEquipment Equipment[]        @relation("EquipmentOwnerBand")
  packlists      Packlist[]
  financeAdmins  BandFinanceAdmin[]
  financeEntries FinanceEntry[]
  locations      Location[]
  lineupRoles    BandLineupRole[]
}

/// Finanzberechtigte Person einer Band - bewusst losgeloest von Role (Admin/Mitglied),
/// damit dieselbe Person gleichzeitig Admin und Finanzadmin sein kann (Personalunion)
/// und mehrere Personen gleichzeitig finanzberechtigt sein koennen. Sieht/verwaltet die
/// vollstaendige Finanzuebersicht der Band; alle anderen sehen nur ihre eigenen Gagen.
model BandFinanceAdmin {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([bandId, userId])
}

/// BALANCE_PAYOUT/BALANCE_DEPOSIT sind direkte Bandkonto-Bewegungen (nur im
/// Abrechnungsmodus BAND_BALANCE moeglich, siehe finance/actions.ts): der
/// Finanzadmin zahlt Mitgliedern Geld aus dem Bandkonto aus, oder Mitglieder
/// zahlen ins Bandkonto ein - anders als bei INCOME/EXPENSE muss die Zuordnung
/// dabei immer 100% betragen. Dient u. a. dazu, das Bandkonto vor einem
/// Wechsel zurueck zu NO_BALANCE auf null auszugleichen.
enum FinanceEntryType {
  INCOME
  EXPENSE
  BALANCE_PAYOUT
  BALANCE_DEPOSIT
}

enum FinanceSettlementMode {
  NO_BALANCE
  BAND_BALANCE
}

/// Einnahme oder Ausgabe der Band, optional einem Termin zugeordnet. Der Finanzadmin
/// ordnet Mitgliedern anteilige Betraege zu (FinanceAllocation) - je nach
/// financeSettlementMode der Band muss deren Summe exakt dem Eintragsbetrag
/// entsprechen oder darf darunter liegen (Rest verrechnet sich mit dem Bandsaldo,
/// durchgesetzt in finance/actions.ts).
model FinanceEntry {
  id          String           @id @default(cuid())
  type        FinanceEntryType
  /// Betrag in Cent (ganzzahlig, um Rundungsfehler bei Geldbetraegen zu vermeiden).
  amountCents Int
  /// Aktuell immer "EUR" - als eigenes Feld angelegt, um spaeter weitere
  /// Waehrungen zu unterstuetzen, ohne bestehende Eintraege migrieren zu muessen.
  currency    String           @default("EUR")
  /// Freier Text; das UI bietet eine feste Auswahlliste an, die ueberschreibbar ist.
  category    String
  description String?
  date        DateTime
  createdAt   DateTime         @default(now())

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  event   Event?  @relation(fields: [eventId], references: [id], onDelete: SetNull)
  eventId String?

  /// Optional statt Pflichtfeld: bleibt bei Konto-Loeschung des/der Erstellenden
  /// erhalten (SetNull) - eine Cascade wuerde sonst auch die Zuordnungen
  /// (FinanceAllocation) anderer Mitglieder an diesem Eintrag mitloeschen,
  /// obwohl deren Gagen/Kostenanteile mit dem geloeschten Konto nichts zu tun
  /// haben. Siehe deleteAccountAction in src/app/(app)/profile/actions.ts.
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  allocations FinanceAllocation[]
}

/// Anteiliger Betrag eines Mitglieds an einer FinanceEntry. Bei Einnahmen eine
/// Auszahlung der Band an das Mitglied (Gage) - das Mitglied selbst bestaetigt hier
/// den Erhalt. Bei Ausgaben ein Kostenanteil, den das Mitglied der Band schuldet -
/// hier bestaetigt der Finanzadmin den Zahlungseingang. Bis zur Bestaetigung gilt
/// der Posten als offen/ausstehend (siehe confirmedAt).
model FinanceAllocation {
  id          String    @id @default(cuid())
  amountCents Int
  note        String?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())

  financeEntry   FinanceEntry @relation(fields: [financeEntryId], references: [id], onDelete: Cascade)
  financeEntryId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([financeEntryId, userId])
}

model Membership {
  id         String    @id @default(cuid())
  role       Role      @default(MEMBER)
  guestUntil DateTime?
  createdAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  /// Vorbelegung fuer neue Gagen-Eintraege dieser Person (in Cent) - bleibt dort
  /// frei aenderbar. null = keine Vorbelegung.
  defaultPayoutAmountCents Int?

  /// E-Mail-Benachrichtigungen je Ereignistyp, pro Person und Band einstellbar
  /// (siehe src/lib/notifications.ts). Standardmaessig an; der Versand passiert
  /// nur, wenn zusaetzlich SMTP konfiguriert ist (siehe src/lib/mail.ts).
  notifyOnNewEvent          Boolean @default(true)
  notifyOnEventChange       Boolean @default(true)
  notifyOnSongProposal      Boolean @default(true)
  notifyOnNewFile           Boolean @default(true)
  notifyOnFinanceAllocation Boolean @default(true)

  @@unique([userId, bandId])
}

model Invitation {
  id         String    @id @default(cuid())
  email      String
  role       Role      @default(MEMBER)
  guestUntil DateTime?
  token      String    @unique @default(cuid())
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  /// Optional statt Pflichtfeld: bleibt bei Konto-Loeschung der einladenden
  /// Person erhalten (SetNull), damit die Einladung weiterhin angenommen
  /// werden kann. Siehe deleteAccountAction in src/app/(app)/profile/actions.ts.
  invitedBy   User?   @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?
}

model Event {
  id          String    @id @default(cuid())
  title       String
  type        EventType @default(REHEARSAL)
  startsAt    DateTime
  endsAt      DateTime
  /// Freitext-Ortsangabe - bleibt nutzbar, wenn kein katalogisierter Ort
  /// verknuepft ist (siehe locationId) oder das Orte-Feature deaktiviert ist.
  /// Im Terminformular EIN gemeinsames Ort-Feld: Freitext, Verknuepfung zu
  /// einem bestehenden Ort oder Neuanlage eines Orts fuehren je nachdem zu
  /// diesem Feld, zu locationId, oder zu beidem.
  location    String?
  description String?
  seriesId    String?
  createdAt   DateTime  @default(now())

  /// Gig-Detailfelder (siehe Abschnitt 3.5 der Spezifikation) - nur fuer
  /// type == GIG relevant, im Formular auch nur dann sichtbar. Beim Wechsel
  /// auf eine andere Terminart bleiben sie unangetastet (kein Datenverlust),
  /// werden lediglich ausgeblendet.
  arrivalAt             DateTime?
  soundcheckAt          DateTime?
  technicalRequirements String?
  gigStatus             GigStatus?

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  /// Optional statt Pflichtfeld: bleibt bei Konto-Loeschung des/der Erstellenden
  /// erhalten (SetNull), damit der Termin fuer die Band nutzbar bleibt - siehe
  /// deleteAccountAction in src/app/(app)/profile/actions.ts.
  createdBy   User?   @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  place      Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  locationId String?

  availabilities Availability[]
  setlists       Setlist[]
  participants   EventParticipant[]
  files          BandFile[]
  packlists      Packlist[]
  financeEntries FinanceEntry[]

  packlistItemEventStatuses   PacklistItemEventStatus[]
  setlistItemEventAnnotations SetlistItemEventAnnotation[]
  setlistEventNotes           SetlistEventNote[]
  setlistEventSnapshots       SetlistEventSnapshot[]
  packlistEventSnapshots      PacklistEventSnapshot[]
  lineup                      EventLineupEntry[]
  rehearsalSongs              RehearsalSong[]
}

/// Mitglieder, für die ein Termin gilt. Standard: bei Probe/Auftritt alle Mitglieder,
/// bei Meeting/Sonstiges nur der/die Ersteller:in - im Termin-Formular individuell anpassbar.
model EventParticipant {
  id String @id @default(cuid())

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([eventId, userId])
}

/// Globaler, band-weiter Katalog typischer Besetzungsrollen (z. B. "Bass",
/// "Lead Guitar"), gepflegt in den Bandeinstellungen. Dient nur als Vorlage
/// fuer neue Gigs (siehe EventLineupEntry) - Aenderungen hier wirken sich
/// nicht rueckwirkend auf bereits bestehende Gigs aus.
model BandLineupRole {
  id    String @id @default(cuid())
  name  String
  order Int

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  /// Optionale "übliche" Besetzung dieser Rolle (z. B. "Bass" -> immer Max),
  /// wird beim Kopieren in einen neuen Gig als Vorbelegung uebernommen, bleibt
  /// dort aber wie jeder andere Eintrag frei aenderbar.
  defaultAssignee   User?   @relation(fields: [defaultAssigneeId], references: [id], onDelete: SetNull)
  defaultAssigneeId String?
}

/// Besetzung eines Auftritts. Der Rollenname wird beim Anlegen des Gigs (oder
/// beim Umstellen eines bestehenden Termins auf GIG) aus BandLineupRole kopiert
/// (denormalisiert, analog SetlistItem.customTitle) und ist danach unabhaengig
/// vom globalen Katalog frei editierbar/erweiterbar. Dieselbe Person kann in
/// mehreren Zeilen auftauchen (Mehrfachrollen, z. B. Gitarre + Backing Vocals).
model EventLineupEntry {
  id    String @id @default(cuid())
  role  String
  order Int

  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?
  /// Freitext fuer Aushilfen/Deps ohne Benutzerkonto, analog PacklistItem.customName.
  assignedToName String?

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
}

model Availability {
  id          String             @id @default(cuid())
  status      AvailabilityStatus
  note        String?
  respondedAt DateTime           @default(now())

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([eventId, userId])
}

model Absence {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model Song {
  id            String     @id @default(cuid())
  title         String
  key           String?
  bpm           Int?
  timeSignature String?
  durationSec   Int?
  genre         String?
  /// Original-Interpret bei Coversongs
  artist        String?
  /// Album, aus ID3-Tags oder Online-Recherche übernehmbar (siehe song-metadata-lookup.ts)
  album         String?
  /// Erscheinungsjahr, aus ID3-Tags oder Online-Recherche übernehmbar
  releaseYear   Int?
  /// Lead-Gesang / Besetzung als Freitext, z. B. "Lead: Anna, BGV: Ben" (Spez. 3.3)
  cast          String?
  /// Coverbild des Songs, wird u. a. bei reiner Audiowiedergabe im Player angezeigt.
  coverUrl      String?
  status        SongStatus @default(NEW)
  /// Bei automatischer Ablehnung durch einstimmiges Downvoting gesetzt (Status ARCHIVED)
  rejected      Boolean    @default(false)
  lyrics        String?
  /// Für alle Bandmitglieder sichtbare Anmerkung, z. B. "Live-Version", Sonderarrangements
  remarks       String?
  /// Geteilte technische Hinweise fuer FOH/Licht/Technik (z. B. "Nebel bei Bridge"),
  /// unabhaengig von der Setlist - erscheint im technischen Ablaufplan-Ausdruck
  /// jeder Setlist, die diesen Song enthaelt (SetlistItem.techNotes ergaenzt dies
  /// nur fuer eine konkrete Setlist).
  techNotes     String?
  /// Vorzähler-Schläge im Übungsmodus (Klick vor Wiedergabe-/Loop-Start), z. B. 3
  /// oder 4. null/0 = kein Einzähler. Grundwert kommt sonst aus der Taktart.
  countInBeats  Int?
  /// Feinversatz der Klick-Spur zum Song-Anfang in Millisekunden (Downbeat-Phase).
  /// Wird beim Analysieren automatisch aus der Beat-Erkennung vorbelegt, im
  /// Übungsmodus manuell nachjustierbar und übernehmbar.
  clickOffsetMs Int?
  createdAt     DateTime   @default(now())

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  proposedBy   User?   @relation("SongProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  proposedById String?

  notes          SongNote[]
  setlistItems   SetlistItem[]
  files          SongFile[]
  links          SongLink[]
  votes          SongVote[]
  bandFiles      BandFile[]
  rehearsalSongs RehearsalSong[]
  practiceLoops  PracticeLoop[]
}

/// Gespeicherter Übungsabschnitt eines Songs (z. B. "Solo", "Bridge") für den
/// Übungsmodus des Medienplayers. Bandweit geteilt - jedes Mitglied kann einen
/// Abschnitt anlegen; löschen darf die anlegende Person oder ein Content-Manager.
model PracticeLoop {
  id        String   @id @default(cuid())
  name      String
  startSec  Float
  endSec    Float
  createdAt DateTime @default(now())

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String

  createdBy   User?   @relation("PracticeLoopCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  @@index([songId])
}

/// Daumen-hoch/-runter-Abstimmung über einen vorgeschlagenen Song, optional mit für alle sichtbarem Kommentar.
model SongVote {
  id        String    @id @default(cuid())
  vote      VoteValue
  comment   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([songId, userId])
}

/// Externer Referenzlink zu einem Song (z. B. Streaming-Plattform, YouTube, Tab-Website). Mehrere pro Song möglich.
model SongLink {
  id        String   @id @default(cuid())
  url       String
  label     String?
  createdAt DateTime @default(now())

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String
}

/// Hochgeladene Datei zu einem Song (z. B. Audio, PDF, Guitar Pro).
/// PRIVATE: nur für die hochladende Person (und Admins) sichtbar. BAND: für alle Bandmitglieder sichtbar.
model SongFile {
  id         String         @id @default(cuid())
  filename   String
  /// Relativer Pfad im (nicht öffentlichen) Dateispeicher - Zugriff nur über die geschützte Download-Route
  storageKey String
  mimeType   String
  size       Int
  visibility FileVisibility @default(BAND)
  createdAt  DateTime       @default(now())

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String

  /// Optional statt Pflichtfeld: bleibt bei Konto-Loeschung der hochladenden
  /// Person erhalten (SetNull) - eine Cascade wuerde sonst die Datei selbst
  /// mitloeschen, obwohl sie weiterhin Teil des Song-Materials der Band ist.
  /// Siehe deleteAccountAction in src/app/(app)/profile/actions.ts.
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?
}

/// Zentraler, bandweiter Dateispeicher (Noten, Verträge, Fotos, Aufnahmen, Sonstiges) -
/// unabhängig von den song-gebundenen Dateien (SongFile). Optional mit Song/Termin/Equipment verknüpfbar.
/// INTERNAL: nur für Bandmitglieder sichtbar. PUBLIC: zusätzlich über einen Link ohne Login abrufbar.
model BandFile {
  id         String             @id @default(cuid())
  filename   String
  /// Relativer Pfad im (nicht öffentlichen) Dateispeicher - Zugriff nur über die geschützten Download-Routen
  storageKey String
  mimeType   String
  size       Int
  category   BandFileCategory   @default(OTHER)
  visibility BandFileVisibility @default(INTERNAL)
  /// Token für den öffentlichen Freigabelink (nur bei visibility=PUBLIC nutzbar)
  shareToken String             @unique @default(cuid())
  createdAt  DateTime           @default(now())

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  /// Optional statt Pflichtfeld: bleibt bei Konto-Loeschung der hochladenden
  /// Person erhalten (SetNull) - eine Cascade wuerde sonst die Datei selbst
  /// mitloeschen, obwohl sie weiterhin Teil des Datenbestands der Band ist.
  /// Siehe deleteAccountAction in src/app/(app)/profile/actions.ts.
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById String?

  /// Mehrfachverknuepfung (m:n): eine Datei kann an beliebig viele Termine,
  /// Songs, Equipment-Eintraege und Orte gleichzeitig gehaengt werden, z. B.
  /// ein am Ort hinterlegter Rider zusaetzlich an einen konkreten Termin.
  events    Event[]
  songs     Song[]
  equipment Equipment[]
  locations Location[]
}

model SongNote {
  id        String   @id @default(cuid())
  content   String
  /// Kurze, einzeilige Bühnen-Notiz - Standardwert, der beim Hinzufügen zu einer Setlist übernommen wird
  shortNote String?
  /// Standard-Hintergrundfarbe für Setlist-Einträge dieses Songs
  color     String?
  /// JSON-kodierte Liste von Hinweis-Icons (Standardwert für Setlist-Einträge)
  cues      String?
  updatedAt DateTime @updatedAt

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([songId, userId])
}

/// Proben-Tracking (abschaltbares Modul, siehe Band.rehearsalTrackingEnabled):
/// explizite Zuordnung "dieser Song wurde an diesem Probentermin geuebt". Zusaetzlich
/// gelten Songs aus Setlisten, die mit dem Probentermin verknuepft sind, als geuebt -
/// das wird jedoch abgeleitet und nicht hier gespeichert (siehe src/lib/rehearsal-songs.ts).
model RehearsalSong {
  id        String   @id @default(cuid())
  /// Optionale Kurznotiz zum Uebungsstand an diesem Termin
  note      String?
  createdAt DateTime @default(now())

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  song    Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  songId  String

  /// Optional statt Pflicht: bleibt bei Konto-Loeschung erhalten (SetNull).
  addedBy   User?   @relation("RehearsalSongAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  addedById String?

  @@unique([eventId, songId])
}

/// Steuert, wie das Equipment-Icon eines INSTRUMENT_CHANGE-Hinweises je Setlist
/// dargestellt wird (siehe CueBadges/setlist-builder.tsx): IN_TAG = klein im
/// Hinweis-Badge (bisheriges Verhalten), LARGE = grosses Icon neben Tonart/BPM,
/// HIDDEN = kein Equipment-Icon (nur der generische Hinweis-Typ-Icon).
enum EquipmentIconDisplay {
  IN_TAG
  LARGE
  HIDDEN
}

model Setlist {
  id                   String               @id @default(cuid())
  name                 String
  createdAt            DateTime             @default(now())
  equipmentIconDisplay EquipmentIconDisplay @default(IN_TAG)
  /// Geteilte (nicht personenbezogene) technische Hinweise fuer die gesamte
  /// Setlist, z. B. fuer FOH/Licht/Technik - im Unterschied zu SetlistNote
  /// (persoenliche Hinweise je Mitglied). Erscheint als Kopfnotiz im
  /// technischen Ablaufplan-Ausdruck.
  techNotes            String?

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  /// Mehrfachverknuepfung (m:n): dieselbe Setlist kann fuer mehrere Termine
  /// wiederverwendet werden. Abhak-/notizfreier terminloser Zustand bleibt
  /// SetlistItemAnnotation/SetlistNote; terminspezifischer Zustand liegt in
  /// SetlistItemEventAnnotation/SetlistEventNote (siehe dort).
  events Event[]

  items          SetlistItem[]
  notes          SetlistNote[]
  eventNotes     SetlistEventNote[]
  eventSnapshots SetlistEventSnapshot[]
}

model SetlistNote {
  id        String   @id @default(cuid())
  content   String
  updatedAt DateTime @updatedAt

  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  setlistId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([setlistId, userId])
}

enum SetlistItemKind {
  SONG
  /// Freier Eintrag mit eigenem Titel (z. B. "Pause"), optional mit Dauer und
  /// aus der Durchnummerierung ausblendbar (siehe excludeFromNumbering).
  CUSTOM
  /// Reine Textzeile, nicht userspezifisch (fuer alle Mitglieder gleich sichtbar,
  /// im Unterschied zu den persoenlichen Notizen in SetlistItemAnnotation).
  /// customTitle traegt den Kommentartext. Nie nummeriert.
  COMMENT
  /// Strukturierende Trennlinie, optional mit Label (customTitle). Nie nummeriert.
  SECTION
}

model SetlistItem {
  id                   String          @id @default(cuid())
  order                Int
  kind                 SetlistItemKind @default(SONG)
  /// Bedeutung je nach kind: Titel des manuellen Eintrags (CUSTOM), Kommentartext
  /// (COMMENT) oder optionales Abschnitts-Label (SECTION) - sowie weiterhin der
  /// Fallback-Titel, wenn der urspruenglich verknuepfte Song geloescht wurde
  /// (SONG, siehe songDeleted).
  customTitle          String?
  /// Nur bei kind=CUSTOM gesetzt: Dauer in Sekunden (z. B. eine Pause), zaehlt
  /// mit in die Gesamtspieldauer der Setlist ein.
  durationSec          Int?
  /// Nur bei kind=CUSTOM relevant: true = wird beim Durchnummerieren
  /// uebersprungen (kein eigener Zaehler-Wert), die Nummerierung setzt sich beim
  /// naechsten zaehlenden Eintrag ohne Luecke fort. SONG zaehlt immer,
  /// COMMENT/SECTION nie - dort ist dieses Feld ohne Bedeutung.
  excludeFromNumbering Boolean         @default(false)
  /// Gesetzt, wenn der ursprünglich verknüpfte Song aus der Bibliothek gelöscht wurde;
  /// customTitle enthält dann dessen früheren Titel als Fallback-Anzeige.
  songDeleted          Boolean         @default(false)
  /// Geteilter (nicht personenbezogener) technischer Zusatzhinweis nur fuer diese
  /// Setlist, ergaenzt Song.techNotes - editierbar von Content-Managern, sichtbar
  /// fuer alle im technischen Ablaufplan-Ausdruck.
  techNotes            String?
  /// Uebergang ohne Pause zum unmittelbar folgenden Eintrag (Segue/Medley) -
  /// nur bei SONG/CUSTOM sinnvoll. Aufeinanderfolgende segued Eintraege werden
  /// in Ansicht/Druck/Text-Export als zusammenhaengender Block dargestellt;
  /// die Nummerierung bleibt unveraendert.
  segueToNext          Boolean         @default(false)

  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  setlistId String

  song   Song?   @relation(fields: [songId], references: [id], onDelete: SetNull)
  songId String?

  annotations      SetlistItemAnnotation[]
  eventAnnotations SetlistItemEventAnnotation[]
}

/// Persönliche, nur für das jeweilige Mitglied sichtbare Markierung eines Setlist-Eintrags
/// (Notiz, Farbe, Hinweis-Icons wie Umstimmen/Instrumentwechsel/Programmwechsel).
model SetlistItemAnnotation {
  id        String   @id @default(cuid())
  note      String?
  color     String?
  /// JSON-kodierte Liste von Hinweis-Icons, z. B. [{"type":"PROGRAM_CHANGE","value":"12"}]
  cues      String?
  updatedAt DateTime @updatedAt

  item   SetlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([itemId, userId])
}

/// Terminspezifisches Pendant zu SetlistItemAnnotation - nur relevant, wenn die
/// Setlist an mehr als einen Termin gehaengt ist (siehe Kommentar an Setlist.events).
/// Bewusst ein eigenes Modell statt eines nullable eventId auf
/// SetlistItemAnnotation: mehrere NULL-Werte gelten in SQL als "verschieden",
/// der bestehende Unique-Constraint (ein allgemeiner Hinweis je Person) waere
/// sonst nicht mehr geschuetzt.
model SetlistItemEventAnnotation {
  id        String   @id @default(cuid())
  note      String?
  color     String?
  cues      String?
  updatedAt DateTime @updatedAt

  item    SetlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId  String
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String

  @@unique([itemId, eventId, userId])
}

/// Terminspezifisches Pendant zu SetlistNote, aus denselben Gruenden ein
/// eigenes Modell statt eines nullable eventId auf SetlistNote.
model SetlistEventNote {
  id        String   @id @default(cuid())
  content   String
  updatedAt DateTime @updatedAt

  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  setlistId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([setlistId, eventId, userId])
}

/// "Wie gespielt"-Momentaufnahme der Setlist fuer einen vergangenen Termin.
/// Entsteht automatisch unmittelbar VOR der ersten Aenderung an der Liste
/// (Song hinzufuegen/entfernen/umsortieren), nachdem ein verknuepfter Termin
/// in die Vergangenheit gerueckt ist, sowie beim nachtraeglichen Verknuepfen
/// eines bereits vergangenen Termins - siehe freezePastSetlistSnapshotsIfNeeded()
/// in setlists/actions.ts. Bis zur ersten Aenderung entspricht der Live-Stand
/// noch exakt dem Stand beim Termin, ein Snapshot ist dann unnoetig.
/// itemsJson denormalisiert Titel/Tonart/Tempo bewusst als Text (wie
/// SetlistItem.customTitle/songDeleted), damit der Snapshot unabhaengig davon
/// bleibt, ob der Song spaeter aus der Bibliothek geloescht oder das Item
/// entfernt wird.
model SetlistEventSnapshot {
  id        String   @id @default(cuid())
  itemsJson String
  createdAt DateTime @default(now())

  setlist   Setlist @relation(fields: [setlistId], references: [id], onDelete: Cascade)
  setlistId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String

  @@unique([setlistId, eventId])
}

enum EquipmentCategory {
  INSTRUMENTS
  INSTRUMENT_ACCESSORIES
  AMPS_PEDALBOARD
  STAGE_EQUIPMENT
  PA
  MONITORING
  PERSONAL
  OTHER
}

/// Katalogeintrag für Equipment. Eigentum entweder bei einer Band (Band-Equipment,
/// nur innerhalb dieser Band nutzbar) oder bei einer Person (persönliches Equipment,
/// nutzbar in jeder Band, in der die Person aktuell Mitglied ist) - genau eines von
/// ownerUserId/ownerBandId ist gesetzt, durchgesetzt in equipment/actions.ts.
model Equipment {
  id          String            @id @default(cuid())
  name        String
  description String?
  category    EquipmentCategory @default(OTHER)
  /// Lagerort, z. B. "Proberaum-Schrank", "Kofferraum Max"
  location    String?
  /// Schluessel aus dem Icon-Katalog (siehe src/lib/equipment-icons.tsx), z. B.
  /// "guitar-strat" - rein optisch, ohne fachliche Bedeutung; null = Platzhalter.
  icon        String?
  /// Frei waehlbarer Hex-Farbwert fuers Icon (z. B. "#3b82f6") - null = Standardfarbe.
  color       String?
  createdAt   DateTime          @default(now())

  ownerUser   User?   @relation("EquipmentOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId String?

  ownerBand   Band?   @relation("EquipmentOwnerBand", fields: [ownerBandId], references: [id], onDelete: Cascade)
  ownerBandId String?

  /// Für Band-Equipment optional festgelegte, für dieses Equipment zuständige Person
  /// (unabhängig vom Eigentum) - wird beim Hinzufügen zu einer Packliste als
  /// Verantwortliche:r vorbelegt, falls gesetzt (sonst der/die Eigentümer:in).
  responsible   User?   @relation("EquipmentResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  responsibleId String?

  packlistItems PacklistItem[]
  files         BandFile[]
}

/// Packliste für einen Gig oder eine Probe, optional mit einem Termin verknüpft.
model Packlist {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  /// Mehrfachverknuepfung (m:n): dieselbe Packliste kann fuer mehrere Termine
  /// wiederverwendet werden. Der globale Abhak-/Zustaendigkeits-Zustand auf
  /// PacklistItem bleibt der terminlose Standard; terminspezifischer Zustand
  /// liegt in PacklistItemEventStatus (siehe dort).
  events Event[]

  items          PacklistItem[]
  eventSnapshots PacklistEventSnapshot[]
}

/// Eintrag einer Packliste - entweder mit einem Equipment-Katalogeintrag verknüpft
/// oder ein freier Eintrag (customName), analog zu SetlistItem/Song.
model PacklistItem {
  id      String  @id @default(cuid())
  order   Int
  checked Boolean @default(false)

  customName String?

  packlist   Packlist @relation(fields: [packlistId], references: [id], onDelete: Cascade)
  packlistId String

  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  equipmentId String?

  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  eventStatuses PacklistItemEventStatus[]
}

/// Analoges "wie gepackt"-Pendant zu SetlistEventSnapshot, mit derselben
/// Vor-jeder-Aenderung-einfrieren-Logik (siehe dort und
/// freezePastPacklistSnapshotsIfNeeded() in equipment/actions.ts). Haelt
/// Name, Abhak- und Zustaendigkeits-Stand denormalisiert fest, weil
/// PacklistItemEventStatus beim Entfernen eines Eintrags kaskadierend
/// mitgeloescht wird.
model PacklistEventSnapshot {
  id        String   @id @default(cuid())
  itemsJson String
  createdAt DateTime @default(now())

  packlist   Packlist @relation(fields: [packlistId], references: [id], onDelete: Cascade)
  packlistId String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String

  @@unique([packlistId, eventId])
}

/// Terminspezifischer Abhak-/Zustaendigkeits-Status eines Packlisten-Eintrags -
/// nur relevant, wenn die Packliste an mehr als einen Termin gehaengt ist.
/// Ohne aktiven Termin-Kontext in der UI gilt weiterhin PacklistItem.checked/
/// assignedToId direkt (siehe Kommentar an Packlist.events).
model PacklistItemEventStatus {
  id      String  @id @default(cuid())
  checked Boolean @default(false)

  item    PacklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId  String
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  @@unique([itemId, eventId])
}

/// Orte-Katalog (Venues) - Advanced Feature, siehe Band.locationsEnabled. Adresse
/// ist bewusst ein einzelnes Freitextfeld statt Strasse/PLZ/Ort-Spalten (analog zu
/// Band.location), da die Geocoding-Anbindung (Nominatim) ohnehin mit einem
/// einzelnen Suchstring arbeitet. latitude/longitude bleiben leer, bis eine
/// Adresse erfolgreich geocodiert oder ein Punkt auf der Karte gesetzt wurde.
model Location {
  id        String  @id @default(cuid())
  name      String
  address   String?
  latitude  Float?
  longitude Float?

  contactName  String?
  contactPhone String?
  contactEmail String?
  website      String?

  /// Fassungsvermögen (Personen)
  capacity               Int?
  /// Bühnenmaße, PA/Technik vorhanden, Stromanschluss etc.
  stageAndTechNotes      String?
  /// Anfahrt, Lademöglichkeit, Parkplätze
  loadingAndParkingNotes String?
  notes                  String?

  createdAt DateTime @default(now())

  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)
  bandId String

  files  BandFile[]
  events Event[]
}
